{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX notes: build PDF",
      "type": "process",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=build/latex",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "LaTeX notes: clean generated files",
      "type": "process",
      "command": "latexmk",
      "args": [
        "-C",
        "-outdir=build/latex",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
