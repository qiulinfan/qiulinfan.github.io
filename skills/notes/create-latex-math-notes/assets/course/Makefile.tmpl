.PHONY: all typst web preview watch edit doctor source-check

MAIN := main.tex
BUILD := build
REPO_ROOT := $(abspath ../../..)
TYPST_BUILD := $(BUILD)/typst

all: web

typst:
	@python3 $(REPO_ROOT)/notes/math/toolchain/scripts/convert_latex_project.py \
		$(MAIN) --build $(TYPST_BUILD)

web: typst
	@$(MAKE) -C $(TYPST_BUILD) preview
	@$(MAKE) -C $(REPO_ROOT) notes-source-check

preview: web

watch: typst
	@$(MAKE) -C $(TYPST_BUILD) watch

edit:
	@code -r {{SLUG}}.code-workspace main.tex

doctor:
	@command -v pandoc >/dev/null
	@command -v typst >/dev/null
	@command -v code >/dev/null
	@echo "LaTeX source -> Typst HTML toolchain is ready."

source-check:
	@$(MAKE) -C $(REPO_ROOT) notes-source-check
