SHELL := /bin/sh

MAIN := main.tex
OUT_DIR := build/latex
PDF := $(OUT_DIR)/main.pdf
LATEXMK := latexmk

.PHONY: all build clean edit

all: build

build:
	@mkdir -p "$(OUT_DIR)"
	$(LATEXMK) -lualatex -synctex=1 -interaction=nonstopmode \
		-halt-on-error -file-line-error -outdir="$(OUT_DIR)" "$(MAIN)"
	@test -f "$(PDF)"
	@echo "PDF: $(PDF)"

clean:
	$(LATEXMK) -C -outdir="$(OUT_DIR)" "$(MAIN)"
	@rmdir "$(OUT_DIR)" 2>/dev/null || true
	@rmdir build 2>/dev/null || true

edit:
	@code -r "{{SLUG}}.code-workspace" "$(MAIN)"
