.PHONY: all release export web web-check watch edit knowledge-sync knowledge-curate

TYPST := typst
TOOLCHAIN := ../toolchain
EXPORT_SKILL := ../../../skills/extract-and-export-notes
REPO_ROOT := ../../..
KGDISTILLER := python3 $(REPO_ROOT)/knowledge/kgd.py
BUILD := build/typst
EXPORTS := exports
COURSE_SLUG := {{SLUG}}

all: release

release: knowledge-curate web-check

export: knowledge-curate
	@python3 $(TOOLCHAIN)/scripts/export_course.py \
		--document notes=main.typ \
		--root ../.. \
		--output $(EXPORTS) \
		--build $(BUILD)/export

knowledge-sync:
	@$(KGDISTILLER) sync --course $(COURSE_SLUG)

knowledge-curate: knowledge-sync
	@$(MAKE) -C $(REPO_ROOT) knowledge-workflow-check

web:
	@mkdir -p $(BUILD)
	@$(TYPST) compile --root ../.. --features html --format html \
		main.typ $(BUILD)/index.html 2>$(BUILD)/index.log || \
		{ cat $(BUILD)/index.log >&2; exit 1; }

web-check: web
	@python3 $(EXPORT_SKILL)/scripts/check_web.py $(BUILD)/index.html

watch:
	@mkdir -p $(BUILD)
	@$(TYPST) watch --root ../.. --features html --format html \
		main.typ $(BUILD)/index.html

edit:
	@code -r $(COURSE_SLUG).code-workspace main.typ
