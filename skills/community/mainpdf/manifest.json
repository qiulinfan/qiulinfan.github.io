{
  "name": "pdf-editor",
  "version": "1.0.1",
  "description": "全能PDF编辑器：提取文字/表格/图片、OCR扫描件识别、插入文字图片、合并拆分、旋转页面、转Word/图片/Html、文档总结归纳",
  "main": "scripts/pdf_core.py",
  "scripts": {
    "install": "python scripts/deps.py || python3 scripts/deps.py",
    "test": "python scripts/pdf_core.py analyze --help || python3 scripts/pdf_core.py analyze --help"
  },
  "dependencies": {
    "PyMuPDF": ">=1.27.0",
    "Pillow": ">=10.0.0",
    "numpy": ">=1.24.0",
    "pdfplumber": ">=0.11.0",
    "python-docx": ">=1.1.0"
  },
  "optionalDependencies": {
    "pytesseract": ">=0.3.10",
    "easyocr": ">=1.7.0"
  },
  "keywords": [
    "PDF编辑", "PDF转换", "PDF提取", "PDF OCR", "扫描件识别",
    "pdf editor", "pdf to word", "pdf to image", "pdf merge",
    "pdf split", "pdf extract text", "pdf table", "pdf 转 word",
    "pdf 转图片", "pdf 合并", "pdf 拆分", "pdf 文字提取"
  ],
  "author": "仙人掌",
  "license": "MIT",
  "os": ["darwin", "linux", "win32"],
  "permissions": {
    "file": {
      "read": ["./", "./output", "./downloads"],
      "write": ["./output", "./downloads", "./temp"]
    },
    "shell": {
      "allowedCommands": ["python", "python3", "pip", "pip3"]
    }
  }
}
