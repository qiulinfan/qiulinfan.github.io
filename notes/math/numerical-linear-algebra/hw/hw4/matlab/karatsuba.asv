% KARATSUBA: Multiply two polynomials using Karatsuba's method.
%   c = karatsuba(a,b) multiplies two polynomials (with coefficient 
%   vectors a and b whose lengths are powers of 2) and returns the product 
%   polynomial coefficients in c (of length 2*n).
%
%   The method computes:
%       p0 = a_left * b_left,
%       p2 = a_right * b_right,
%       p1 = (a_left+a_right) * (b_left+b_right),
%   then combines these as:
%       c = p0 + (p1 - p0 - p2)*x^(n/2) + p2*x^n.
function c = karatsuba(a, b)
    n = length(a);
    if n == 1
        c = [0, a * b];
        return;
    end
    
    half = n / 2;
    % Divide the polynomials into halves.
    a_left  = a(1:half);
    a_right = a(half+1:end);
    b_left  = b(1:half);
    b_right = b(half+1:end);
    
    % Three recursive multiplications.
    p0 = karatsuba(a_left, b_left);function c = karatsuba(a, b)
% KARATSUBA: Multiply two polynomials using Karatsuba's method.
%   c = karatsuba(a,b) multiplies two polynomials (with coefficient 
%   vectors a and b whose lengths are powers of 2) and returns the product 
%   polynomial coefficients in c (of length 2*n).
%
%   The method computes:
%       p0 = a_left * b_left,
%       p2 = a_right * b_right,
%       p1 = (a_left+a_right) * (b_left+b_right),
%   then combines these as:
%       c = p0 + (p1 - p0 - p2)*x^(n/2) + p2*x^n.

    n = length(a);
    if n == 1
        c = [0, a * b];
        return;
    end
    
    half = n / 2;
    % Divide the polynomials into halves.
    a_left  = a(1:half);
    a_right = a(half+1:end);
    b_left  = b(1:half);
    b_right = b(half+1:end);
    
    % Three recursive multiplications.
    p0 = karatsuba(a_left, b_left);
    p2 = karatsuba(a_right, b_right);
    p1 = karatsuba(a_left + a_right, b_left + b_right);
    
    % Compute the middle term.
    mid = p1 - p0 - p2;
    
    % Allocate the result vector.
    c = zeros(1, 2 * n);
    c(1:2*half)         = c(1:2*half) + p0;
    c(half+1:half+2*half) = c(half+1:half+2*half) + mid;
    c(n+1:2*n)          = c(n+1:2*n) + p2;
end

    p2 = karatsuba(a_right, b_right);
    p1 = karatsuba(a_left + a_right, b_left + b_right);
    
    % Compute the middle term.
    mid = p1 - p0 - p2;
    
    % Allocate the result vector.
    c = zeros(1, 2 * n);
    c(1:2*half)         = c(1:2*half) + p0;
    c(half+1:half+2*half) = c(half+1:half+2*half) + mid;
    c(n+1:2*n)          = c(n+1:2*n) + p2;
end
