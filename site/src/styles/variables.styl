  --surface-deep: #eaeef2 #21252b
  --surface-hover: rgba(9, 105, 218, .07) rgba(97, 175, 239, .10)
  --text-strong: #24292f #e5e9f0
  --text: #424a53 #abb2bf
  --text-muted: #57606a #8f98a7
  --muted: #6e7781 #697180
  --border: #d0d7de rgba(171, 178, 191, .17)
  --violet: #8250df #c678dd
  --cyan: #1b7c83 #56b6c2
  --green: #1a7f37 #98c379
  --yellow: #9a6700 #e5c07b
  --red: #cf222e #e06c75
