/*
 * QL site design contract
 *
 * This is the single source of truth for the visual identity shared by the
 * homepage, blog, notes, and knowledge graph. Components consume semantic
 * variables from this file; changing the palette or surface treatment here
 * changes the whole site.
 */

white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

:root
  --radius-small .55rem
  --radius-medium .75rem
  --radius-large .875rem
  --content-delay 150ms
  --font-sans -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif
  --font-mono "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
  --card-shadow 0 18px 50px rgba(9, 14, 25, .10)
  --site-backdrop-opacity .09
  --site-backdrop-filter saturate(.72) contrast(.92)

:root.dark
  --card-shadow 0 20px 55px rgba(7, 10, 16, .24)
  --site-backdrop-opacity .30
  --site-backdrop-filter saturate(.78) contrast(.92) brightness(.72)

/* An util to define variables that vary with light and dark mode. */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  /* Brand palette: GitHub Light / One Dark Pro. */
