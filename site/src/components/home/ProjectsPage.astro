---
import { projectGroups } from "@/data/home";
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import { url } from "@utils/url-utils";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
---

<LandingPageLayout
	title={zh ? "项目" : "Projects"}
	lang={zh ? "zh-CN" : "en"}
	description={zh ? "Qiulin 的游戏、引擎与研究项目。" : "Qiulin's game, engine, and research projects."}
>
	<div class="projects-page">
		<header class="projects-hero">
			<div class="hero-meta">
				<span>PROJECTS / 2024—2026</span>
				<nav><a href={url(zh ? "/zh/" : "/")}>← {zh ? "主页" : "Home"}</a><a href={url(zh ? "/projects/" : "/zh/projects/")}>{zh ? "English" : "中文"} ↗</a></nav>
			</div>
			<h1>{zh ? "项目" : "Projects"}</h1>
		</header>

		<div class="project-sections">
			{projectGroups.map((group, groupIndex) => (
				<section class="project-section">
					<header class="section-heading">
						<span>{String(groupIndex + 1).padStart(2, "0")}</span>
						<h2>{zh ? group.titleZh : group.title}</h2>
					</header>
					<div class:list={["project-grid", { single: group.projects.length === 1 }]}>
						{group.projects.map((project) => (
							<a class="project-card" href={project.href} target="_blank" rel="noreferrer">
								<header><span>{project.tags.join(" · ")}</span><strong>{project.linkLabel} ↗</strong></header>
								<h3>{project.title}</h3>
								<p>{zh ? project.descriptionZh : project.description}</p>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</div>
</LandingPageLayout>

<style>
	.projects-page { padding: clamp(2rem, 6vw, 6rem) 0 4rem; }
	.projects-hero { margin-bottom: clamp(5rem, 10vw, 9rem); border-bottom: 1px solid var(--border); padding: 0 .25rem clamp(2.5rem, 6vw, 5rem); }
	.hero-meta { display: flex; justify-content: space-between; gap: 1rem; align-items: center; color: var(--primary); font: 700 .64rem/1.2 var(--font-mono); letter-spacing: .14em; }
	.hero-meta nav { display: flex; gap: 1.2rem; }
	.hero-meta a { color: var(--primary); text-decoration: none; }
	.projects-hero h1 { max-width: 10ch; margin: clamp(3rem, 8vw, 7rem) 0 0; color: var(--text-strong); font-size: clamp(4rem, 11vw, 9.5rem); font-weight: 700; line-height: .82; letter-spacing: -.025em; }
	.project-sections { display: grid; gap: clamp(5rem, 9vw, 8rem); }
	.project-section { scroll-margin-top: 6rem; }
	.section-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 1.2rem; margin-bottom: 1.4rem; padding: 0 .25rem; }
	.section-heading span, .project-card header { font: 650 .62rem/1.4 var(--font-mono); letter-spacing: .1em; }
	.section-heading span { color: var(--primary); }
	.section-heading h2 { margin: 0; color: var(--text-strong); font-size: clamp(2rem, 5vw, 4.4rem); font-weight: 700; line-height: .95; letter-spacing: -.035em; }
	.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.project-grid.single { grid-template-columns: minmax(0, 1fr); }
	.project-card { min-height: 16rem; border: 1px solid var(--border); border-radius: var(--radius-large); padding: clamp(1.3rem, 3vw, 2.2rem); display: flex; flex-direction: column; background: var(--card-bg); color: inherit; text-decoration: none; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
	.project-card:hover { border-color: color-mix(in srgb, var(--primary) 48%, var(--border)); background: var(--surface-hover); transform: translateY(-3px); }
	.project-card header { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); }
	.project-card header strong { color: var(--primary); font-weight: 650; white-space: nowrap; }
	.project-card h3 { margin: auto 0 .9rem; color: var(--text-strong); font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 700; line-height: .95; letter-spacing: -.035em; }
	.project-card p { max-width: 44rem; margin: 0; color: var(--text-muted); line-height: 1.65; }
	@media (max-width: 760px) {
		.projects-page { padding-top: 2rem; }
		.hero-meta { align-items: flex-start; flex-direction: column; }
		.projects-hero h1 { margin-top: 3rem; }
		.project-grid { grid-template-columns: 1fr; }
		.project-card { min-height: 14rem; }
	}
</style>
