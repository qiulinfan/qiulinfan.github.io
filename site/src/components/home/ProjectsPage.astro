---
import { projects } from "@/data/home";
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import { url } from "@utils/url-utils";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
---

<LandingPageLayout
	title={zh ? "项目" : "Projects"}
	lang={zh ? "zh-CN" : "en"}
	description={zh ? "Qiulin 的游戏、引擎与研究项目。" : "Qiulin's game, engine, and research projects."}
>
	<div class="projects-page">
		<header class="projects-hero card">
			<span>SELECTED GAME WORK / 2024—2026</span>
			<h1>{zh ? "游戏项目" : "Game projects"}</h1>
			<p>{zh ? "关卡、战斗、敌人行为、工具与交互系统。每个项目都保留可运行版本。" : "Levels, combat, enemy behavior, tools, and interaction systems. Each project links to a playable build."}</p>
			<div><a href={url(zh ? "/zh/#work" : "/#work")}>← {zh ? "返回主页" : "Back home"}</a><a href={url(zh ? "/projects/" : "/zh/projects/")}>{zh ? "English" : "中文"} ↗</a></div>
		</header>

		<div class="project-list">
			{projects.map((project, index) => (
				<article class="project-row card">
					<a class="media" href={project.href}><img src={url(project.image)} alt={`${project.title} screenshot`} /></a>
					<div class="copy">
						<span>{String(index + 1).padStart(2, "0")} / {project.tags.join(" · ")}</span>
						<h2>{project.title}</h2>
						<p>{zh ? project.descriptionZh : project.description}</p>
						<a class="button" href={project.href}>{zh ? "打开项目" : "Open project"} ↗</a>
					</div>
				</article>
			))}
		</div>
	</div>
</LandingPageLayout>

<style>
	.projects-page { display: flex; flex-direction: column; gap: 2rem; padding-top: 1rem; }
	.card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); backdrop-filter: blur(20px) saturate(1.08); }
	.projects-hero { min-height: 22rem; padding: clamp(1.5rem, 5vw, 4rem); display: flex; flex-direction: column; justify-content: end; background: linear-gradient(125deg, color-mix(in srgb, var(--primary) 12%, var(--card-bg)), var(--card-bg)); }
	.projects-hero > span, .copy > span { color: var(--primary); font: 700 .64rem/1.2 var(--font-mono); letter-spacing: .14em; }
	.projects-hero h1 { margin: .7rem 0; color: var(--text-strong); font-size: clamp(3rem, 8vw, 7rem); font-weight: 760; line-height: .9; letter-spacing: -.075em; }
	.projects-hero p { max-width: 48rem; margin: 0; color: var(--text-muted); line-height: 1.75; }
	.projects-hero > div { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.4rem; }
	.projects-hero a { color: var(--primary); font: 650 .65rem/1 var(--font-mono); text-decoration: none; }
	.project-list { display: flex; flex-direction: column; gap: 1rem; }
	.project-row { padding: 1rem; display: grid; grid-template-columns: 1.1fr .9fr; gap: 1rem; }
	.media { min-height: 27rem; border-radius: var(--radius-medium); overflow: hidden; background: var(--surface-deep); }
	.media img { width: 100%; height: 100%; object-fit: cover; }
	.copy { padding: clamp(1rem, 4vw, 3rem); display: flex; flex-direction: column; justify-content: center; }
	.copy h2 { margin: .7rem 0; color: var(--text-strong); font-size: clamp(2rem, 5vw, 4rem); font-weight: 720; line-height: .95; letter-spacing: -.06em; }
	.copy p { margin: 0; color: var(--text-muted); line-height: 1.75; }
	.button { align-self: flex-start; min-height: 2.8rem; margin-top: 1.5rem; padding: 0 1rem; display: inline-flex; align-items: center; border-radius: var(--radius-small); background: var(--primary); color: var(--primary-contrast); font-size: .75rem; font-weight: 650; text-decoration: none; }
	@media (max-width: 760px) {
		.project-row { grid-template-columns: 1fr; }
		.media { min-height: 18rem; }
	}
</style>
