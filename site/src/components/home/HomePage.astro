---
import { homepageLinks, projects } from "@/data/home";
import { profileConfig } from "@/config";
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import { loadListedNoteSources } from "@utils/note-sources";
import { url } from "@utils/url-utils";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const featuredNotes = [
	...loadListedNoteSources().map((source) => ({
		title: source.title,
		field: source.fields[0] ?? source.subject,
		href: source.navigationHref,
		standalone: source.standalone,
	})),
];
const copy = zh
	? {
			eyebrow: "QIULIN FAN",
			headline: "Game & AI Engineer",
			notesCta: "阅读笔记",
			workCta: "查看项目",
			language: "English",
			workKicker: "01 / SELECTED WORK",
			workTitle: "游戏项目",
			allProjects: "项目详情",
			page: "项目页面",
			repo: "源代码",
			notesKicker: "02 / NOTES",
			notesTitle: "笔记",
			researchKicker: "03 / RESEARCH",
			researchTitle: "TODO",
		}
	: {
			eyebrow: "QIULIN FAN",
			headline: "Game & AI Engineer",
			notesCta: "Read the notes",
			workCta: "See selected work",
			language: "中文",
			workKicker: "01 / SELECTED WORK",
			workTitle: "Game projects",
			allProjects: "Project details",
			page: "Project page",
			repo: "Repository",
			notesKicker: "02 / NOTES",
			notesTitle: "Notes",
			researchKicker: "03 / RESEARCH",
			researchTitle: "TODO",
		};
---

<LandingPageLayout
	lang={zh ? "zh-CN" : "en"}
	description={zh ? "Qiulin 的个人主页与笔记。" : "Qiulin's portfolio and notes."}
>
	<div class="homepage">
		<section class="hero card" aria-labelledby="hero-title">
			<div class="hero-copy">
				<div class="identity"><img src={profileConfig.avatar} alt={profileConfig.name} /><span class="eyebrow">{copy.eyebrow}</span></div>
				<h1 id="hero-title">{copy.headline}</h1>
				<div class="hero-actions">
					<a class="button primary" href={url("/notes/")}>{copy.notesCta}<span>→</span></a>
					<a class="button" href="#work">{copy.workCta}<span>↓</span></a>
					<a class="button language" href={url(zh ? "/" : "/zh/")}>{copy.language}<span>↗</span></a>
				</div>
			</div>
		</section>

		<section class="section" id="work">
			<header class="section-heading">
				<div><span>{copy.workKicker}</span><h2>{copy.workTitle}</h2></div>
				<div class="section-link"><a href={url(zh ? "/zh/projects/" : "/projects/")}>{copy.allProjects} ↗</a></div>
			</header>
			<div class="project-grid">
				{projects.map((project) => (
					<a class="project-card card" href={project.href} target="_blank" rel="noreferrer">
						<div class="project-image"><img src={url(project.image)} alt={`${project.title} screenshot`} loading="lazy" /></div>
						<div class="project-copy">
							<span>{project.tags.join(" · ")}</span>
							<h3>{project.title}</h3>
							<strong>OPEN PROJECT ↗</strong>
						</div>
					</a>
				))}
			</div>
			<article class="engine-card card">
				<div class="engine-copy">
					<span>C++17 · SDL2 · LUA · BOX2D · IMGUI</span><h3>PocketEngine</h3>
					<div>
						<a class="button primary" href={homepageLinks.pocketEngine}>{copy.page} ↗</a>
						<a class="button" href={homepageLinks.pocketEngineRepository}>{copy.repo} ↗</a>
					</div>
				</div>
				<a class="engine-media" href={homepageLinks.pocketEngine}><img src={`${homepageLinks.pocketEngine}show.gif`} alt="PocketEngine editor preview" loading="lazy" /></a>
			</article>
		</section>

		<section class="section" id="notes">
			<header class="section-heading">
				<div><span>{copy.notesKicker}</span><h2>{copy.notesTitle}</h2></div>
			</header>
			<div class="note-grid">
				{featuredNotes.map((note, index) => (
					<a class="note-card card" href={url(note.href)} data-no-swup={note.standalone || undefined}><span>{String(index + 1).padStart(2, "0")} / {note.field}</span><h3>{note.title}</h3><strong>→</strong></a>
				))}
			</div>
		</section>

		<section class="section" id="research">
			<header class="section-heading">
				<div><span>{copy.researchKicker}</span><h2>{copy.researchTitle}</h2></div>
			</header>
		</section>
	</div>
</LandingPageLayout>

<style>
	:global(body:has(.homepage)) { background-image: linear-gradient(color-mix(in srgb, var(--page-bg) 60%, transparent), color-mix(in srgb, var(--page-bg) 60%, transparent)), url("/assets/backgrounds/one-dark-sakura-right-v3.webp"); background-position: center, right top; background-size: cover; background-attachment: fixed; background-repeat: no-repeat; }
	:global(html.dark body:has(.homepage)) { background-image: linear-gradient(color-mix(in srgb, var(--page-bg) 10%, transparent), color-mix(in srgb, var(--page-bg) 10%, transparent)), url("/assets/backgrounds/one-dark-sakura-right-v3.webp"); }
	.homepage { position: relative; display: flex; flex-direction: column; gap: clamp(5rem, 10vw, 9rem); padding-top: 1rem; }
	.card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); backdrop-filter: blur(20px) saturate(1.08); transition: transform .18s ease, border-color .18s ease, background .18s ease; }
	.button { min-height: 2.8rem; padding: 0 1rem; display: inline-flex; align-items: center; justify-content: space-between; gap: .9rem; border: 1px solid var(--border); border-radius: var(--radius-small); color: var(--text-strong); background: color-mix(in srgb, var(--card-bg) 78%, transparent); font-size: .75rem; font-weight: 650; text-decoration: none; backdrop-filter: blur(12px); }
	.button:hover { border-color: color-mix(in srgb, var(--primary) 46%, var(--border)); transform: translateY(-2px); }
	.button.primary { border-color: transparent; background: var(--primary); color: var(--primary-contrast); }
	.button.language { margin-left: auto; }
	.hero { min-height: calc(74vh - 7rem); padding: clamp(1.5rem, 5vw, 4.5rem); display: flex; align-items: end; overflow: hidden; background: color-mix(in srgb, var(--card-bg) 46%, transparent); backdrop-filter: saturate(1.02); }
	:global(html.dark) .hero { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.hero-copy { width: min(100%, 56rem); }
	.identity { display: flex; align-items: center; gap: .85rem; }
	.identity img { width: 3.25rem; height: 3.25rem; border: 1px solid rgba(255, 255, 255, .25); border-radius: 50%; object-fit: cover; }
	.eyebrow, .section-heading span, .project-copy > span, .engine-copy > span { color: var(--primary); font: 700 .66rem/1.2 var(--font-mono); letter-spacing: .16em; }
	h1 { max-width: 8ch; margin: .8rem 0 0; color: var(--text-strong); font-size: clamp(3.2rem, 8vw, 7.8rem); font-weight: 700; line-height: .89; letter-spacing: -.025em; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 2rem; }
	.section { scroll-margin-top: 6rem; }
	.section-heading { display: grid; grid-template-columns: 1fr minmax(18rem, .7fr); align-items: end; gap: 2rem; margin-bottom: 1.5rem; }
	.section-heading h2 { margin: .45rem 0 0; color: var(--text-strong); font-size: clamp(2rem, 5vw, 4.2rem); font-weight: 720; line-height: .95; letter-spacing: -.058em; }
	.section-heading > .section-link { justify-self: end; max-width: 28rem; }
	.section-heading p { margin: 0; color: var(--text-muted); line-height: 1.65; }
	.section-heading a { display: inline-block; margin-top: .65rem; color: var(--primary); font: 650 .7rem/1 var(--font-mono); text-decoration: none; }
	.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.project-card { min-width: 0; color: inherit; text-decoration: none; overflow: hidden; }
	.project-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); }
	.project-image { aspect-ratio: 16 / 11; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--surface-deep); }
	.project-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
	.project-card:hover img { transform: scale(1.025); }
	.project-copy { min-height: 10rem; padding: 1.3rem; display: flex; flex-direction: column; }
	.project-copy h3, .engine-copy h3, .note-card h3 { margin: .65rem 0; color: var(--text-strong); font-size: 1.55rem; font-weight: 700; letter-spacing: -.035em; }
	.project-copy > strong { margin-top: auto; padding-top: 1.4rem; color: var(--primary); font: 650 .6rem/1 var(--font-mono); letter-spacing: .1em; }
	.engine-card { margin-top: 1rem; padding: 1rem; display: grid; grid-template-columns: minmax(0, .8fr) minmax(22rem, 1.2fr); gap: 1rem; }
	.engine-copy { padding: clamp(1rem, 3vw, 2.4rem); display: flex; flex-direction: column; justify-content: center; }
	.engine-copy h3 { font-size: clamp(2rem, 4vw, 3.4rem); }
	.engine-copy > div { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.5rem; }
	.engine-media { min-height: 23rem; border-radius: var(--radius-medium); overflow: hidden; background: var(--surface-deep); }
	.engine-media img { width: 100%; height: 100%; object-fit: cover; }
	.note-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
	.note-card { position: relative; min-height: 12rem; padding: 1.2rem; display: flex; flex-direction: column; color: inherit; text-decoration: none; }
	.note-card > span { color: var(--muted); font: 600 .58rem/1.4 var(--font-mono); text-transform: uppercase; }
	.note-card h3 { margin-top: auto; }
	.note-card > strong { position: absolute; right: 1.2rem; bottom: 1.2rem; color: var(--primary); }
	.note-card:hover { background: var(--surface-hover); transform: translateY(-3px); }
	@media (max-width: 900px) {
		.section-heading { grid-template-columns: 1fr; }
		.section-heading > .section-link { justify-self: start; }
		.project-grid { grid-template-columns: 1fr 1fr; }
		.engine-card { grid-template-columns: 1fr; }
		.note-grid { grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 600px) {
		.homepage { padding-top: .4rem; gap: 5rem; }
		.hero { min-height: calc(100vh - 6rem); border-radius: .65rem; padding: 1.3rem; }
		h1 { font-size: clamp(3rem, 16vw, 5rem); }
		.button.language { margin-left: 0; }
		.project-grid, .note-grid { grid-template-columns: 1fr; }
		.engine-card { padding: .7rem; }
		.engine-media { min-height: 15rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { transition-duration: .01ms !important; }
	}
</style>
