---
import { profileConfig } from "@/config";
import { Icon } from "astro-icon/components";
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import { url } from "@utils/url-utils";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const github = profileConfig.links.find((link) => link.name === "GitHub");
const bio = [
	"This is Qiulin Fan, from Shanghai and currently based in Ann Arbor. I'm completing my B.S. in Honors Mathematics and Computer Science at the University of Michigan (2023–2026).",
	"Over the past few years I have worked on game engine physics and particle systems, gameplay engineering, and agentic knowledge systems for games. I previously worked at Unity China and NetEase Games.",
	"I am currently seeking out of engineering and looking for research opportunities in generative world models, 3D vision, and robot learning.",
];
const favoriteCharacters = [
	{ name: "Yatogami Tohka", href: "https://date-a-live.fandom.com/wiki/Tohka_Yatogami" },
	{ name: "Kuchiki Rukia", href: "https://bleach.fandom.com/wiki/Rukia_Kuchiki" },
];
const name = "bluesamoyed77";
// Each inner array is one pair of related tools, shown as a group.
const tools = [
	[
		{
			label: "My agent harness",
			name: "omp",
			icon: "/assets/tools/omp.png",
			href: "https://github.com/qiulinfan/oh-my-pi",
			text: "My version of oh-my-pi as my daily agent harness, with a desktop and browser GUI that also sits in VS Code and Obsidian (justnotes) side bars, Claude Code hooks and nested AGENTS.md, file checkpoints to rewind code, approval modes with an auto mode, agent presets, sessions that can message each other, and in-place updates from my own releases.",
		},
		{
			label: "My code editor",
			name: "Zed",
			icon: "/assets/tools/zed.png",
			href: "https://github.com/qiulinfan/zed",
			text: "Slight modifications on Zed, my main editor. Mostly I adjusted its ACP support so external agent threads stay in sync with the agents' own session lists, and removed the Zed cloud services I don't need.",
		},
	],
	[
		{
			label: "My note taking app",
			name: "justnotes",
			icon: "/assets/tools/justnotes.png",
			href: "https://github.com/qiulinfan/justnotes",
			text: "My little open source note taking app substituting Obsidian, with rich Markdown and native TeX support, and compatible with all Obsidian plugins. I use it to edit Markdown and LaTeX files.",
		},
		{
			label: "My personal knowledge base",
			name: "kgdistiller",
			href: "https://github.com/qiulinfan/kgdistiller",
			text: "My agentic knowledge base system, especially designed for systems with formal logic and for research paper reading.",
		},
	],
	[
		{
			label: "My 2D game engine (very nostalgic)",
			name: "pocket2d",
			icon: "/assets/tools/pocket2d.png",
			href: "https://qiulinfan.github.io/pocket2d/",
			text: "This is a nostalgic 2D game engine built from the project of my EECS 404 Game Engine Architecture course: a C++26 / SDL3 runtime and editor with Lua gameplay. Agents play and test games through a structured protocol with deterministic stepping and replay; games package for macOS, Windows, Linux and the web, with two-player rollback netplay.",
		},
	],
	[
		{
			label: "My 2D game art pipeline",
			name: "Discrete Sprite Lab",
			href: "https://github.com/qiulinfan/discrete-sprite-lab",
			text: "It turns generated images into clean pixel art. Perfect Pixel lattice recovery places every pixel 1:1 on a shared canvas with a canonical palette; eight-direction turnarounds rotate continuously; actions are animated from authored key poses with kinematics, joint-anchor alignment, controlled inbetweens and procedural animation. Everything ships as reproducible agent Skills.",
		},
		{
			label: "My 3D game art pipeline",
			name: "autoTA",
			href: "https://github.com/qiulinfan/autoTA",
			text: "It turns a design brief into audited 3D assets. A requirement matrix drives license-verified sourcing or hosted generation (Meshy, Hunyuan, Tripo); Blender adapts geometry, UVs, PBR materials and rigs; humanoid animations are retargeted and aligned; and an isolated audit chain with round-trip validation issues a receipt before anything reaches Unity or Unreal.",
		},
	],
];
const amorisMedia = "https://qiulinfan.github.io/amoris/media/";
const amoris = {
	site: "https://qiulinfan.github.io/amoris/",
	repo: "https://github.com/qiulinfan/amoris",
	hero: `${amorisMedia}editor-pool.jpg`,
	points: [
		{
			title: "Agents play it",
			image: `${amorisMedia}windroad-player-poster.jpg`,
			href: "https://qiulinfan.github.io/amoris/documentation/agents/",
			text: "The editor, the CLI, HTTP and MCP share one command API. An agent can play through a player seat the engine enforces, seeing and doing only what a player could. The picture is DeepSeek Flash flying Windward through the native player seat, replayed from its recorded calls.",
		},
		{
			title: "Agents debug it",
			image: `${amorisMedia}windroad-debug-poster.jpg`,
			href: "https://qiulinfan.github.io/amoris/documentation/api/",
			text: "The simulation is deterministic, so any run can be snapshotted, replayed, forked and stepped back in time. TypeScript gameplay hot-updates at a tick boundary, with a source-level debugger and a profiler.",
		},
		{
			title: "And it still looks good",
			image: `${amorisMedia}pool-loop.webp`,
			href: "https://qiulinfan.github.io/amoris/",
			text: "A wgpu renderer on Metal, Vulkan, Direct3D 12 and WebGPU, with GPU culling, TAA, GTAO, baked GI and ray-traced shadows and reflections, and GPU water that computes the same bits on every device, so it replays with the world.",
		},
	],
	games: [
		{
			name: "Windward",
			href: "https://qiulinfan.github.io/amoris/play/windward/",
			about: "https://qiulinfan.github.io/amoris/documentation/wind-road/",
			image: `${amorisMedia}windroad-poster.jpg`,
			text: "Fly a glider through ten wind gates between floating islands.",
			run: "DeepSeek Flash, about 88 minutes, 356 steps",
		},
		{
			name: "Emberlight",
			href: "https://qiulinfan.github.io/amoris/play/emberlight/",
			about: "https://qiulinfan.github.io/amoris/documentation/emberlight/",
			image: `${amorisMedia}emberlight-poster.jpg`,
			text: "Turn mirrors and a prism to light five lanterns across four observatory chambers.",
			run: "DeepSeek Flash, about 100 minutes, 421 steps",
		},
	],
};
const games = [
	{
		name: "Blockcraft",
		engine: "Amoris",
		href: "https://bluesamoyed77.itch.io/blockcraft",
		image: "/assets/projects/blockcraft-v8-walk.webp",
		text: "A voxel sandbox island. Break and build blocks while the engine's shallow water floods broken banks and drains into holes.",
	},
	{
		name: "Bleach vs Naruto",
		engine: "pocket2d",
		href: "https://bluesamoyed77.itch.io/bleach-vs-naruto-pocket2d-remaster",
		image: "/assets/projects/bvn-pocket.jpg",
		text: "A fan remake of 5DPLAY's fighting game, with the original roster and online versus over rollback netcode.",
	},
	{
		name: "Village Rim",
		engine: "pocket2d",
		href: "https://bluesamoyed77.itch.io/village-rim",
		image: "/assets/projects/village-rim-pocket2d.jpg",
		text: "Our four-person Unity adventure, moved onto pocket2d with its gameplay rewritten in Lua. The itch.io page has the original Unity build.",
	},
	{
		name: "PocketTerraria",
		engine: "pocket2d",
		href: "/assets/projects/pocket-terraria.mp4",
		image: "/assets/projects/pocket-terraria.jpg",
		text: "A Terraria-style sandbox built to test pocket2d, played all the way to the Moon Lord. Video only; it is not released.",
	},
];
const itchUrl = "https://bluesamoyed77.itch.io/";
// The avatar is a crop of this fan drawing; keep the credit beside it.
const avatarCredit = {
	work: "https://www.pixiv.net/en/artworks/138386116",
	artist: "hyojennn",
	artistUrl: "https://www.pixiv.net/en/users/119647895",
};
---

<LandingPageLayout
	lang={zh ? "zh-CN" : "en"}
	description={zh ? "Qiulin 的个人主页与笔记。" : "Qiulin's portfolio and notes."}
>
	<div class="homepage">
		<section class="hero card" aria-labelledby="hero-title">
			<div class="hero-copy">
				<div class="hero-grid">
					<div class="identity"><img src={profileConfig.avatar} alt="" width="347" height="347" loading="eager" decoding="async" fetchpriority="high" /><div class="identity-text"><h1 id="hero-title">{name}</h1>{github && <a class="profile-link" href={github.url} target="_blank" rel="noreferrer"><Icon name={github.icon} />{github.url.replace(/^https:\/\//, "")}</a>}</div></div>
					<div class="bio">{bio.map((paragraph) => <p>{paragraph}</p>)}<p>My favorite animation characters are <a href={favoriteCharacters[0].href} target="_blank" rel="noreferrer">{favoriteCharacters[0].name}</a> and <a href={favoriteCharacters[1].href} target="_blank" rel="noreferrer">{favoriteCharacters[1].name}</a>.</p></div>
				</div>
				<p class="avatar-credit">Avatar: <a href={avatarCredit.work} target="_blank" rel="noreferrer">Rukia</a> by <a href={avatarCredit.artistUrl} target="_blank" rel="noreferrer">{avatarCredit.artist}</a> on pixiv</p>
			</div>
		</section>

		<section class="tools card" aria-labelledby="tools-title">
			<h2 id="tools-title">Useful (to me) little tools I make</h2>
			{tools.map((group) => (
				<div class="tool-group">
					{group.map((tool) => (
						<div class="tool">
							<p class="tool-label">{tool.label}</p>
							<div class="tool-body">
								<a class="pill tool-name" href={tool.href} target="_blank" rel="noreferrer">{tool.icon && <img src={url(tool.icon)} alt="" width="22" height="22" />}{tool.name}</a>
								<p>{tool.text}</p>
							</div>
						</div>
					))}
				</div>
			))}
		</section>

		<section class="amoris card" aria-labelledby="amoris-title">
			<header class="amoris-head">
				<h2 id="amoris-title"><a href={amoris.site} target="_blank" rel="noreferrer">Amoris</a></h2>
				<p>My low-key huge project, and my favorite. It is the implementation of an idea of mine: a game engine designed for agent-native gameplay and debugging.</p>
				<p class="amoris-links"><a class="pill" href={amoris.site} target="_blank" rel="noreferrer">Showcase</a><a class="pill" href={amoris.repo} target="_blank" rel="noreferrer">GitHub</a></p>
			</header>
			<img class="amoris-hero" src={amoris.hero} alt="The Amoris web editor playing Pool party" loading="lazy" decoding="async" />
			<div class="amoris-points">
				{amoris.points.map((point) => (
					<div class="amoris-point">
						<a href={point.href} target="_blank" rel="noreferrer"><img src={point.image} alt="" loading="lazy" decoding="async" /></a>
						<div>
							<h3>{point.title}</h3>
							<p>{point.text}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="games card" aria-label="Games">
			<p class="games-note">I barely promote my projects, but I really love them.</p>
			<p>If you want some games, you can also go to my <a href={itchUrl} target="_blank" rel="noreferrer">itch.io</a>. These are made on my own engines, mostly in one shot:</p>
			<div class="game-list">
				{games.map((game) => (
					<a class="game" href={game.href.startsWith("http") ? game.href : url(game.href)} target="_blank" rel="noreferrer">
						<img src={url(game.image)} alt="" loading="lazy" decoding="async" />
						<span class="game-name">{game.name} <span>on {game.engine}</span></span>
						<span class="game-text">{game.text}</span>
					</a>
				))}
			</div>
			<div class="agent-games">
				<p>And two games that agents made on Amoris by themselves, playable in a desktop browser with WebGPU. Each was made by one autonomous agent from a single prompt, with nobody answering its questions.</p>
				<div class="game-list">
					{amoris.games.map((game) => (
						<div class="game">
							<a href={game.href} target="_blank" rel="noreferrer"><img src={game.image} alt="" loading="lazy" decoding="async" /></a>
							<span class="game-name"><a href={game.href} target="_blank" rel="noreferrer">{game.name}</a> <span>· <a href={game.about} target="_blank" rel="noreferrer">prompt and run</a></span></span>
							<span class="game-text">{game.text}</span>
							<span class="game-run">{game.run}</span>
						</div>
					))}
				</div>
			</div>
		</section>
	</div>
</LandingPageLayout>

<style>
	.card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); backdrop-filter: blur(20px) saturate(1.08); }
	.homepage { position: relative; display: flex; flex-direction: column; gap: clamp(1.25rem, 2.5vw, 2rem); padding-top: 1rem; font-family: var(--font-sans); }
	.hero { min-height: calc(74vh - 7rem); padding: clamp(1.5rem, 5vw, 4.5rem); display: flex; align-items: end; overflow: hidden; background: color-mix(in srgb, var(--card-bg) 46%, transparent); backdrop-filter: saturate(1.02); }
	:global(html.dark) .hero { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.hero-copy { width: min(100%, 70rem); }
	.hero-grid { display: grid; grid-template-columns: auto minmax(0, 34rem); align-items: center; justify-content: start; gap: clamp(2rem, 6vw, 6rem); }
	.identity { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
	.identity img { width: clamp(6rem, 11vw, 9rem); height: clamp(6rem, 11vw, 9rem); border: 1px solid rgba(255, 255, 255, .25); border-radius: 50%; object-fit: cover; }
	.identity-text { display: flex; flex-direction: column; gap: .9rem; min-width: 0; }
	.profile-link { display: inline-flex; align-items: center; gap: .5rem; width: fit-content; padding: .5rem .85rem; border: 1px solid var(--border); border-radius: var(--radius-small); background: color-mix(in srgb, var(--card-bg) 70%, transparent); color: var(--text-strong); font: 600 .85rem/1 var(--font-sans); text-decoration: none; backdrop-filter: blur(10px); transition: border-color .18s ease, color .18s ease; }
	.profile-link :global(svg) { width: 1.05rem; height: 1.05rem; }
	.profile-link:hover { border-color: color-mix(in srgb, var(--sakura) 55%, var(--border)); color: var(--sakura); }
	.profile-link:focus-visible { outline: 2px solid var(--sakura); outline-offset: 2px; }
	h1 { margin: 0; color: var(--text-strong); font-size: clamp(2.2rem, 4.2vw, 3.6rem); font-weight: 700; line-height: 1; letter-spacing: -.025em; }
	.bio { color: var(--text-strong); font-family: var(--font-sans); font-size: clamp(1.02rem, 1.35vw, 1.16rem); font-weight: 500; line-height: 1.7; letter-spacing: .005em; }
	.bio p { margin: 0; text-wrap: pretty; }
	.bio a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--sakura) 60%, transparent); text-underline-offset: .22em; }
	.bio a:hover { color: var(--sakura); }
	.avatar-credit { margin: clamp(2rem, 4vw, 3rem) 0 0; color: var(--text-muted); font-size: .75rem; }
	.avatar-credit a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
	.avatar-credit a:hover { color: var(--sakura); }
	.bio p + p { margin-top: .85rem; }
	.tools { padding: clamp(1.5rem, 5vw, 4.5rem); color: var(--text-strong); background: color-mix(in srgb, var(--card-bg) 46%, transparent); }
	:global(html.dark) .tools { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.tools h2 { margin: 0 0 clamp(1.5rem, 3vw, 2.25rem); color: var(--text-strong); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 700; letter-spacing: -.02em; }
	.tool-group { display: grid; gap: 1.6rem; padding: 1.6rem 0; border-top: 1px solid var(--border); }
	.tool { display: grid; grid-template-columns: minmax(10rem, 14rem) minmax(0, 40rem); gap: clamp(1rem, 4vw, 3rem); }
	.tool-label { margin: .15rem 0 0; color: var(--text-muted); font-size: .85rem; font-weight: 500; line-height: 1.5; }
	.tool-body p { margin: .7rem 0 0; font-size: clamp(.95rem, 1.2vw, 1.04rem); font-weight: 500; line-height: 1.65; text-wrap: pretty; }
	.pill { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem .95rem; border: 1px solid color-mix(in srgb, var(--text-strong) 28%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--card-bg) 60%, transparent); color: var(--text-strong); font-weight: 700; text-decoration: none; transition: border-color .18s ease, color .18s ease, background .18s ease; }
	.pill:hover { border-color: var(--sakura); color: var(--sakura); background: color-mix(in srgb, var(--sakura) 10%, transparent); }
	.pill:focus-visible { outline: 2px solid var(--sakura); outline-offset: 2px; }
	.pill img { width: 1.4rem; height: 1.4rem; border-radius: .3rem; object-fit: contain; }
	.tool-name { font-size: 1.05rem; }
	.games { padding: clamp(1.5rem, 5vw, 4.5rem); color: var(--text-strong); background: color-mix(in srgb, var(--card-bg) 46%, transparent); }
	:global(html.dark) .games { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.games-note { font-size: clamp(1.1rem, 1.6vw, 1.3rem); font-weight: 700 !important; }
	.games > p { margin: 0 0 1.25rem; font-weight: 500; line-height: 1.65; }
	.games > p a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--sakura) 60%, transparent); text-underline-offset: .22em; }
	.games > p a:hover { color: var(--sakura); }
	.game-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1.25rem; }
	.game { display: flex; flex-direction: column; gap: .45rem; color: inherit; text-decoration: none; }
	.game img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--border); border-radius: var(--radius-medium); }
	.game-name { margin-top: .3rem; font-weight: 700; }
	.game-name span { color: var(--text-muted); font-size: .8rem; font-weight: 500; }
	.game-text { color: var(--text-strong); font-size: .9rem; font-weight: 500; line-height: 1.55; }
	.game:hover .game-name { color: var(--sakura); }
	.game:hover img { border-color: color-mix(in srgb, var(--sakura) 55%, var(--border)); }
	.amoris { padding: clamp(1.5rem, 5vw, 4.5rem); color: var(--text-strong); background: color-mix(in srgb, var(--card-bg) 46%, transparent); }
	:global(html.dark) .amoris { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.amoris-head { max-width: 42rem; }
	.amoris-head h2 { margin: 0; font-size: clamp(2.2rem, 4.2vw, 3.6rem); font-weight: 700; line-height: 1; letter-spacing: -.025em; }
	.amoris-head h2 a { color: var(--text-strong); text-decoration: none; }
	.amoris-head h2 a:hover { color: var(--sakura); }
	.amoris-head p { margin: 1rem 0 0; font-size: clamp(1.02rem, 1.35vw, 1.16rem); font-weight: 500; line-height: 1.7; text-wrap: pretty; }
	.amoris-links { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem !important; }
	.game-name a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--sakura) 60%, transparent); text-underline-offset: .22em; }
	.game-name a:hover { color: var(--sakura); }
	.amoris-hero { display: block; width: 100%; aspect-ratio: 21 / 9; margin-top: clamp(1.75rem, 3.5vw, 2.5rem); object-fit: cover; border: 1px solid var(--border); border-radius: var(--radius-large); }
	.amoris-points { display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); margin-top: clamp(1.75rem, 3.5vw, 2.5rem); }
	.amoris-point { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 36rem); align-items: center; gap: clamp(1.25rem, 4vw, 3rem); }
	.amoris-point img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--border); border-radius: var(--radius-medium); }
	.amoris-point h3 { margin: 0; color: var(--text-strong); font-size: 1.15rem; font-weight: 700; }
	.amoris-point p { margin: .4rem 0 0; font-size: clamp(.95rem, 1.2vw, 1.04rem); font-weight: 500; line-height: 1.65; text-wrap: pretty; }
	.agent-games { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: clamp(1.75rem, 3.5vw, 2.5rem); border-top: 1px solid var(--border); }
	.agent-games > p { margin: 0 0 1.25rem; max-width: 42rem; font-weight: 500; line-height: 1.65; }
	.game-run { color: var(--text-muted); font-size: .8rem; font-weight: 500; }
	@media (max-width: 900px) {
		.amoris-point { grid-template-columns: 1fr; gap: .9rem; }
		.tool { grid-template-columns: 1fr; gap: .2rem; }
		.hero-grid { grid-template-columns: 1fr; align-items: start; }
	}
	@media (max-width: 600px) {
		.homepage { padding-top: .4rem; gap: 1rem; }
		.hero { min-height: calc(100vh - 6rem); border-radius: .65rem; padding: 1.3rem; }
		h1 { font-size: clamp(1.8rem, 8.5vw, 3.4rem); }
	}
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { transition-duration: .01ms !important; }
	}
</style>
