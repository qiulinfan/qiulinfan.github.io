---
import { profileConfig } from "@/config";
import { Icon } from "astro-icon/components";
import LandingPageLayout from "@layouts/LandingPageLayout.astro";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const github = profileConfig.links.find((link) => link.name === "GitHub");
const bio = [
	"This is Qiulin Fan, from Shanghai and currently based in Ann Arbor. I'm completing my B.S. in Honors Mathematics and Computer Science at the University of Michigan (2023–2026).",
	"Over the past few years I have worked on game engine physics and particle systems, gameplay engineering, and agentic knowledge systems for games. I previously worked at Unity China and NetEase Games.",
	"I am currently seeking out of engineering and looking for research opportunities in generative world models, 3D vision, and robot learning.",
];
const favoriteCharacters = [
	{ name: "Yatogami Tohka", href: "https://date-a-live.fandom.com/wiki/Tohka_Yatogami" },
	{ name: "Kuchiki Rukia", href: "https://bleach.fandom.com/wiki/Rukia_Kuchiki" },
];
const name = "bluesamoyed77";
// The avatar is a crop of this fan drawing; keep the credit beside it.
const avatarCredit = {
	work: "https://www.pixiv.net/en/artworks/138386116",
	artist: "hyojennn",
	artistUrl: "https://www.pixiv.net/en/users/119647895",
};
---

<LandingPageLayout
	lang={zh ? "zh-CN" : "en"}
	description={zh ? "Qiulin 的个人主页与笔记。" : "Qiulin's portfolio and notes."}
>
	<div class="homepage">
		<section class="hero card" aria-labelledby="hero-title">
			<div class="hero-copy">
				<div class="hero-grid">
					<div class="identity"><img src={profileConfig.avatar} alt="" width="347" height="347" loading="eager" decoding="async" fetchpriority="high" /><div class="identity-text"><h1 id="hero-title">{name}</h1>{github && <a class="profile-link" href={github.url} target="_blank" rel="noreferrer"><Icon name={github.icon} />{github.url.replace(/^https:\/\//, "")}</a>}</div></div>
					<div class="bio">{bio.map((paragraph) => <p>{paragraph}</p>)}<p>My favorite animation characters are <a href={favoriteCharacters[0].href} target="_blank" rel="noreferrer">{favoriteCharacters[0].name}</a> and <a href={favoriteCharacters[1].href} target="_blank" rel="noreferrer">{favoriteCharacters[1].name}</a>.</p></div>
				</div>
				<p class="avatar-credit">Avatar: <a href={avatarCredit.work} target="_blank" rel="noreferrer">Rukia</a> by <a href={avatarCredit.artistUrl} target="_blank" rel="noreferrer">{avatarCredit.artist}</a> on pixiv</p>
			</div>
		</section>
	</div>
</LandingPageLayout>

<style>
	.card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); backdrop-filter: blur(20px) saturate(1.08); }
	.homepage { position: relative; display: flex; flex-direction: column; gap: clamp(5rem, 10vw, 9rem); padding-top: 1rem; font-family: var(--font-sans); }
	.hero { min-height: calc(74vh - 7rem); padding: clamp(1.5rem, 5vw, 4.5rem); display: flex; align-items: end; overflow: hidden; background: color-mix(in srgb, var(--card-bg) 46%, transparent); backdrop-filter: saturate(1.02); }
	:global(html.dark) .hero { background: color-mix(in srgb, var(--card-bg) 16%, transparent); }
	.hero-copy { width: min(100%, 70rem); }
	.hero-grid { display: grid; grid-template-columns: auto minmax(0, 34rem); align-items: center; justify-content: start; gap: clamp(2rem, 6vw, 6rem); }
	.identity { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
	.identity img { width: clamp(6rem, 11vw, 9rem); height: clamp(6rem, 11vw, 9rem); border: 1px solid rgba(255, 255, 255, .25); border-radius: 50%; object-fit: cover; }
	.identity-text { display: flex; flex-direction: column; gap: .9rem; min-width: 0; }
	.profile-link { display: inline-flex; align-items: center; gap: .5rem; width: fit-content; padding: .5rem .85rem; border: 1px solid var(--border); border-radius: var(--radius-small); background: color-mix(in srgb, var(--card-bg) 70%, transparent); color: var(--text-warm); font: 600 .85rem/1 var(--font-sans); text-decoration: none; backdrop-filter: blur(10px); transition: border-color .18s ease, color .18s ease; }
	.profile-link :global(svg) { width: 1.05rem; height: 1.05rem; }
	.profile-link:hover { border-color: color-mix(in srgb, var(--sakura) 55%, var(--border)); color: var(--sakura); }
	.profile-link:focus-visible { outline: 2px solid var(--sakura); outline-offset: 2px; }
	h1 { margin: 0; color: var(--text-warm); font-size: clamp(2.2rem, 4.2vw, 3.6rem); font-weight: 700; line-height: 1; letter-spacing: -.025em; }
	.bio { color: var(--text-warm); font-family: var(--font-sans); font-size: clamp(1.02rem, 1.35vw, 1.16rem); font-weight: 500; line-height: 1.7; letter-spacing: .005em; }
	.bio p { margin: 0; text-wrap: pretty; }
	.bio a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--sakura) 60%, transparent); text-underline-offset: .22em; }
	.bio a:hover { color: var(--sakura); }
	.avatar-credit { margin: clamp(2rem, 4vw, 3rem) 0 0; color: var(--text-muted); font-size: .75rem; }
	.avatar-credit a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
	.avatar-credit a:hover { color: var(--sakura); }
	.bio p + p { margin-top: .85rem; }
	@media (max-width: 900px) {
		.hero-grid { grid-template-columns: 1fr; align-items: start; }
	}
	@media (max-width: 600px) {
		.homepage { padding-top: .4rem; gap: 5rem; }
		.hero { min-height: calc(100vh - 6rem); border-radius: .65rem; padding: 1.3rem; }
		h1 { font-size: clamp(1.8rem, 8.5vw, 3.4rem); }
	}
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { transition-duration: .01ms !important; }
	}
</style>
