---
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import { Icon } from "astro-icon/components";
import { friendLinks } from "@/data/friends";

interface Props {
	lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const title = zh ? "朋友们" : "Friends";
---

<LandingPageLayout
	title={title}
	lang={zh ? "zh-CN" : "en"}
	description={title}
>
	<div class="friends-page">
		<header class="friends-hero">
			<h1>{title}</h1>
		</header>

		<section class="friends-grid" aria-label={title}>
			{friendLinks.map((friend) => (
				<a
					class="friend-card"
					href={friend.href}
					target="_blank"
					rel="noopener noreferrer"
				>
					<div class="avatar" aria-hidden="true">
						{friend.avatar
							? <img src={friend.avatar} alt="" loading="lazy" decoding="async" />
							: <span>{friend.name.slice(0, 1)}</span>}
					</div>
					<div class="friend-copy">
						<h2>{friend.name}</h2>
						<p>{zh ? friend.descriptionZh : friend.description}</p>
					</div>
					<Icon class="external-icon" name="fa6-solid:arrow-up-right-from-square" />
				</a>
			))}
		</section>
	</div>
</LandingPageLayout>

<style>
	.friends-page {
		padding: clamp(2rem, 6vw, 6rem) 0 4rem;
		font-family: var(--font-sans);
	}

	.friends-hero {
		margin-bottom: clamp(2rem, 5vw, 4rem);
		border-bottom: 1px solid var(--border);
		padding: clamp(2.5rem, 7vw, 6rem) .25rem clamp(2.5rem, 5vw, 4.5rem);
	}

	h1 {
		margin: 0;
		color: var(--text-strong);
		font-size: clamp(4rem, 11vw, 9.5rem);
		font-weight: 700;
		line-height: .82;
		letter-spacing: -.04em;
	}

	.friends-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.friend-card {
		position: relative;
		min-height: 11rem;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.2rem;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		box-shadow: var(--card-shadow);
		color: inherit;
		text-decoration: none;
		backdrop-filter: blur(20px) saturate(1.08);
		transition: transform .18s ease, border-color .18s ease, background .18s ease;
	}

	.friend-card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--primary) 48%, var(--border));
		background: var(--surface-hover);
	}

	.avatar {
		width: 5.25rem;
		height: 5.25rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--primary) 35%, var(--border));
		border-radius: 1.15rem;
		background: color-mix(in srgb, var(--primary) 15%, var(--card-bg));
		color: var(--primary);
		font-size: 2rem;
		font-weight: 750;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.friend-copy {
		min-width: 0;
	}

	.friend-copy h2 {
		margin: 0 0 .35rem;
		color: var(--text-strong);
		font-size: clamp(1.35rem, 2.4vw, 1.8rem);
		font-weight: 700;
		letter-spacing: -.035em;
	}

	.friend-copy p {
		margin: 0;
		color: var(--text-muted);
		font-size: .86rem;
		line-height: 1.55;
	}

	.external-icon {
		align-self: start;
		width: .75rem;
		height: .75rem;
		color: var(--muted);
	}

	.friend-card:hover .external-icon {
		color: var(--primary);
	}

	@media (max-width: 760px) {
		.friends-page { padding-top: 2rem; }
		.friends-grid { grid-template-columns: 1fr; }
		.friend-card { min-height: 9rem; grid-template-columns: auto minmax(0, 1fr); }
		.external-icon { position: absolute; right: 1.15rem; top: 1.15rem; }
	}

	@media (max-width: 460px) {
		.friend-card { gap: 1rem; padding: 1rem; }
		.avatar { width: 4.25rem; height: 4.25rem; border-radius: .9rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.friend-card { transition-duration: .01ms; }
	}
</style>
