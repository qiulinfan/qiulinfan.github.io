---
import WidePageLayout from "@layouts/WidePageLayout.astro";
import { noteSubjectLabels, noteTree } from "@/docks/notes/catalog";
import { loadListedNoteSources } from "@/docks/notes/sources";
import { url } from "@utils/url-utils";

const sources = loadListedNoteSources({
	usePublishedStandalone: import.meta.env.DEV,
});
const resolvedHref = (href: string) =>
	href.startsWith("http") ? href : url(href);

// Tree geometry, in SVG units; the drawing scales with its container.
const colWidth = 290;
const rowHeight = 74;
const nodeWidth = 245;
const nodeHeight = 46;
const pad = 8;
const nodes = noteTree.map((node) => {
	const source = node.source ? sources.find((candidate) => candidate.id === node.source) : undefined;
	return {
		...node,
		source,
		x: pad + node.col * colWidth,
		y: pad + node.row * rowHeight,
	};
});
const byId = new Map(nodes.map((node) => [node.id, node]));
const edges = nodes.flatMap((node) =>
	node.prerequisites.map((id) => {
		const from = byId.get(id)!;
		const x1 = from.x + nodeWidth;
		const y1 = from.y + nodeHeight / 2;
		const x2 = node.x;
		const y2 = node.y + nodeHeight / 2;
		const bend = (x2 - x1) / 2;
		return {
			key: `${id}->${node.id}`,
			d: `M${x1} ${y1} C${x1 + bend} ${y1}, ${x2 - bend} ${y2}, ${x2} ${y2}`,
			pending: !node.source,
		};
	}),
);
const width = pad * 2 + Math.max(...nodes.map((node) => node.x)) + nodeWidth;
const height = pad * 2 + Math.max(...nodes.map((node) => node.y)) + nodeHeight;
const published = nodes.filter((node) => node.source);
---

<WidePageLayout title="Notes" description="Notes">
	<section class="notes-index card-base">
		<header>
			<h1>Notes</h1>
			<p>My notes, laid out by what each subject builds on. Solid boxes are published and open the notes; dashed ones are still being written.</p>
			<p class="legend">
				<span><i class="dot math"></i>{noteSubjectLabels.math}</span>
				<span><i class="dot cs"></i>{noteSubjectLabels.cs}</span>
				<span><i class="dot philosophy"></i>{noteSubjectLabels.philosophy}</span>
			</p>
		</header>

		<div class="tree-scroll">
			<svg class="tree" viewBox={`0 0 ${width} ${height}`} role="group" aria-label="Notes arranged by prerequisites">
				{edges.map((edge) => (
					<path class:list={["edge", { pending: edge.pending }]} d={edge.d} />
				))}
				{nodes.map((node) => node.source ? (
					<a class="node" href={resolvedHref(node.source.navigationHref)} data-no-swup={node.source.standalone || undefined}>
						<title>{node.source.title}</title>
						<rect x={node.x} y={node.y} width={nodeWidth} height={nodeHeight} rx="12" />
						<circle class:list={["dot", node.subject]} cx={node.x + 18} cy={node.y + nodeHeight / 2} r="4.5" />
						<text x={node.x + 32} y={node.y + nodeHeight / 2}>{node.label}</text>
					</a>
				) : (
					<g class="node pending">
						<rect x={node.x} y={node.y} width={nodeWidth} height={nodeHeight} rx="12" />
						<circle class:list={["dot", node.subject]} cx={node.x + 18} cy={node.y + nodeHeight / 2} r="4.5" />
						<text x={node.x + 32} y={node.y + nodeHeight / 2}>{node.label}</text>
					</g>
				))}
			</svg>
		</div>

		<div class="published">
			{published.map((node) => (
				<div class="note">
					<p class="note-meta"><i class:list={["dot", node.subject]}></i>{node.source!.fields.join(", ")}</p>
					<div>
						<a class="pill" href={resolvedHref(node.source!.navigationHref)} data-no-swup={node.source!.standalone || undefined}>{node.source!.title}</a>
						<p>{node.source!.description}</p>
					</div>
				</div>
			))}
		</div>
	</section>
</WidePageLayout>

<style>
	.notes-index { padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius-large); color: var(--text-strong); font-family: var(--font-sans); }
	header h1 { margin: 0; font-size: clamp(2.2rem, 6vw, 4.5rem); }
	header p { max-width: 42rem; margin: 1rem 0 0; font-weight: 500; line-height: 1.65; }
	.legend { display: flex; gap: 1.25rem; color: var(--text-muted); font-size: .85rem; }
	.legend span { display: inline-flex; align-items: center; gap: .45rem; }
	i.dot { display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; }
	i.dot.math, circle.dot.math { background: var(--sakura); fill: var(--sakura); }
	i.dot.cs, circle.dot.cs { background: var(--primary); fill: var(--primary); }
	i.dot.philosophy, circle.dot.philosophy { background: var(--violet); fill: var(--violet); }
	.tree-scroll { margin-top: clamp(1.75rem, 3.5vw, 2.5rem); overflow-x: auto; }
	.tree { display: block; width: 100%; min-width: 60rem; height: auto; }
	.edge { fill: none; stroke: color-mix(in srgb, var(--text-strong) 32%, transparent); stroke-width: 1.5; }
	.edge.pending { stroke-dasharray: 4 5; stroke: color-mix(in srgb, var(--text-strong) 20%, transparent); }
	.node rect { fill: color-mix(in srgb, var(--card-bg) 85%, transparent); stroke: color-mix(in srgb, var(--text-strong) 45%, transparent); stroke-width: 1.2; transition: stroke .18s ease, fill .18s ease; }
	.node text { fill: var(--text-strong); font-size: 14px; font-weight: 600; dominant-baseline: central; }
	a.node:hover rect, a.node:focus-visible rect { stroke: var(--sakura); fill: color-mix(in srgb, var(--sakura) 12%, var(--card-bg)); }
	a.node:hover text { fill: var(--sakura); }
	a.node:focus { outline: none; }
	.node.pending rect { fill: transparent; stroke: color-mix(in srgb, var(--text-strong) 26%, transparent); stroke-dasharray: 5 5; }
	.node.pending text { fill: var(--text-muted); font-weight: 500; }
	.node.pending circle { opacity: .5; }
	.published { margin-top: clamp(2rem, 4vw, 3rem); }
	.note { display: grid; grid-template-columns: minmax(10rem, 14rem) minmax(0, 40rem); gap: clamp(1rem, 4vw, 3rem); padding: 1.4rem 0; border-top: 1px solid var(--border); }
	.note-meta { display: flex; align-items: center; gap: .5rem; margin: .45rem 0 0; color: var(--text-muted); font-size: .85rem; font-weight: 500; }
	.note p:not(.note-meta) { margin: .7rem 0 0; font-weight: 500; line-height: 1.65; }
	.pill { display: inline-flex; align-items: center; padding: .4rem .95rem; border: 1px solid color-mix(in srgb, var(--text-strong) 28%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--card-bg) 60%, transparent); color: var(--text-strong); font-weight: 700; text-decoration: none; transition: border-color .18s ease, color .18s ease, background .18s ease; }
	.pill:hover { border-color: var(--sakura); color: var(--sakura); background: color-mix(in srgb, var(--sakura) 10%, transparent); }
	@media (max-width: 760px) {
		.note { grid-template-columns: 1fr; gap: .2rem; }
	}
</style>
