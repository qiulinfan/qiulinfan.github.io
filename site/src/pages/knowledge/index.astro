---
import KnowledgeGraph from "@components/knowledge/KnowledgeGraph.svelte";
import WidePageLayout from "@layouts/WidePageLayout.astro";
import { url } from "@utils/url-utils";

const graphUrl = url("/knowledge/graph.json");
---

<WidePageLayout
	title="Knowledge Graph"
	description="Search and explore Qiulin's source-backed personal knowledge graph."
>
	<KnowledgeGraph dataUrl={graphUrl} client:load />
</WidePageLayout>
