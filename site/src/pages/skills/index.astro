---
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import {
	loadOwnedSkills,
	loadPublishedSkills,
	loadSkillCatalogMarkdown,
	loadSkillWorkflowsMarkdown,
} from "@utils/skill-sources";
import MarkdownIt from "markdown-it";

const publishedSkills = loadPublishedSkills();
const ownedSkills = loadOwnedSkills();
const ownedIds = new Set(ownedSkills.map((skill) => skill.id));
const publishedById = new Map(
	publishedSkills.map((skill) => [skill.id, skill]),
);
const skillAnchor = (id: string) => `skill-${id.replace(/[^a-z0-9]+/gi, "-")}`;

const markdown = new MarkdownIt({
	html: false,
	linkify: true,
	typographer: false,
});

function resolveCatalogLinks(source: string): string {
	return source.replace(/\]\(\.\/([^/)]+)\/\)/g, (match, id: string) => {
		const skill = publishedById.get(id);
		if (!skill) return match;
		const href = ownedIds.has(id) ? `#${skillAnchor(id)}` : skill.sourceHref;
		return `](${href})`;
	});
}

const catalogHtml = markdown.render(
	resolveCatalogLinks(loadSkillCatalogMarkdown()),
);
const workflowSource = loadSkillWorkflowsMarkdown();
const workflowTokens = markdown.parse(workflowSource, {});
type MarkdownToken = (typeof workflowTokens)[number];
const workflowIntroTokens: MarkdownToken[] = [];
const workflows: Array<{
	title: string;
	tokens: MarkdownToken[];
}> = [];
let workflowTitle = "Skill Workflows";
let currentWorkflow: (typeof workflows)[number] | undefined;

for (let index = 0; index < workflowTokens.length; index += 1) {
	const token = workflowTokens[index];
	if (token.type === "heading_open" && token.tag === "h1") {
		workflowTitle = workflowTokens[index + 1]?.content || workflowTitle;
		index += 2;
		continue;
	}
	if (token.type === "heading_open" && token.tag === "h2") {
		currentWorkflow = {
			title:
				workflowTokens[index + 1]?.content ||
				`Workflow ${workflows.length + 1}`,
			tokens: [],
		};
		workflows.push(currentWorkflow);
		index += 2;
		continue;
	}
	(currentWorkflow?.tokens ?? workflowIntroTokens).push(token);
}

const renderTokens = (tokens: MarkdownToken[]) =>
	markdown.renderer.render(tokens, markdown.options, {});
const workflowIntroHtml = renderTokens(workflowIntroTokens);
const renderedWorkflows = workflows.map((workflow) => ({
	...workflow,
	html: renderTokens(workflow.tokens),
}));
---

<LandingPageLayout
	title="Skills & Workflows"
	description="Reusable Agent Skills and the Markdown-authored workflows they form together."
>
	<div class="skills-page">
		<header class="skills-hero">
			<div class="hero-meta">
				<span>CAPABILITIES × ORCHESTRATION</span>
				<span>{String(publishedSkills.length).padStart(2, "0")} SKILLS · {String(renderedWorkflows.length).padStart(2, "0")} FLOWS</span>
			</div>
			<div class="hero-grid">
				<h1>Skills<br /><em>&amp; Flows</em></h1>
				<div class="hero-copy" data-pagefind-body>
					<p>Skill 是能力单元，Workflow 决定它们如何协作。目录与流程都直接来自仓库里的 Markdown。</p>
					<nav aria-label="Page sections">
						<a href="#skill-index">Skill 导航 ↓</a>
						<a href="#workflows">工具流 ↓</a>
						<a href="#skill-details">自有 Skills ↓</a>
					</nav>
					<aside>
						<span>AGENTS / NEXT</span>
						<p>未来的 Agent 会有独立页面；这里保留能力、编排关系与实现详情三层信息。</p>
					</aside>
				</div>
			</div>
		</header>

		<section id="skill-index" class="index-section" data-pagefind-body>
			<header class="section-header">
				<div><span>01 / README</span><h2>Skill 导航</h2></div>
				<p>简介以 <code>skills/README.md</code> 为权威来源。自有 Skill 链到本页详情，社区 Skill 链到它的来源文件。</p>
			</header>
			<div class="markdown-panel catalog-markdown" set:html={catalogHtml} />
		</section>

		<section id="workflows" class="workflow-section" data-pagefind-body>
			<header class="section-header">
				<div><span>02 / WORKFLOWS.MD</span><h2>{workflowTitle}</h2></div>
				<div class="workflow-intro" set:html={workflowIntroHtml} />
			</header>
			<div class="workflow-list">
				{renderedWorkflows.map((workflow, index) => (
					<article class="workflow-card">
						<header class="workflow-heading">
							<div class="workflow-number">{String(index + 1).padStart(2, "0")}</div>
							<div>
								<span>WORKFLOW / MARKDOWN AUTHORED</span>
								<h3>{workflow.title}</h3>
							</div>
						</header>
						<div class="workflow-body" set:html={workflow.html} />
					</article>
				))}
			</div>
		</section>

		<section id="skill-details" class="details-section">
			<header class="section-header">
				<div><span>03 / OWNED SKILLS</span><h2>自有 Skill 详情</h2></div>
				<p>这里只展示“个人维护”清单中的 Skill。社区 Skill 已在第一层提供来源链接，不重复展开。</p>
			</header>
			<div class="skill-list" data-pagefind-body aria-label="Personally maintained Agent Skills">
				{ownedSkills.map((skill, index) => (
					<article class="skill-card" id={skillAnchor(skill.id)}>
						<header>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<code>{skill.id}</code>
						</header>
						<h3>{skill.name}</h3>
						<p>{skill.description}</p>
						<footer>
							{skill.license && <span>{skill.license}</span>}
							<a href={skill.sourceHref} target="_blank" rel="noreferrer">SKILL.md ↗</a>
						</footer>
					</article>
				))}
			</div>
		</section>
	</div>
</LandingPageLayout>

<style>
	.skills-page { padding: clamp(2rem, 6vw, 6rem) 0 3rem; }
	.skills-hero { margin-bottom: clamp(5rem, 10vw, 9rem); border-bottom: 1px solid var(--border); padding: 0 .25rem clamp(2rem, 5vw, 4rem); }
	.hero-meta, .skills-hero aside span, .section-header span, .workflow-heading span, .skill-card header, .skill-card footer { font: 650 .62rem/1.4 var(--font-mono); letter-spacing: .1em; }
	.hero-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); }
	.hero-meta span:first-child, .section-header span, .workflow-heading span { color: var(--primary); }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); align-items: end; gap: clamp(2rem, 6vw, 7rem); margin-top: clamp(3rem, 8vw, 7rem); }
	.skills-hero h1 { margin: 0; color: var(--text-strong); font-size: clamp(4rem, 11vw, 9.5rem); font-weight: 760; line-height: .72; letter-spacing: -.085em; }
	.skills-hero h1 em { color: var(--primary); font-size: .66em; font-style: normal; }
	.hero-copy > p { max-width: 31rem; margin: 0; color: var(--text-strong); font-size: clamp(1.25rem, 2.5vw, 2rem); font-weight: 610; line-height: 1.25; letter-spacing: -.035em; }
	.hero-copy nav { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.6rem; }
	.hero-copy nav a { border: 1px solid var(--border); border-radius: var(--radius-small); padding: .75rem .9rem; background: var(--card-bg); color: var(--primary); font: 650 .68rem/1 var(--font-mono); text-decoration: none; }
	.skills-hero aside { display: grid; grid-template-columns: auto 1fr; gap: 1rem; margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem; }
	.skills-hero aside span { color: var(--violet); white-space: nowrap; }
	.skills-hero aside p { margin: 0; color: var(--text-muted); font-size: .78rem; line-height: 1.6; }
	.index-section, .workflow-section, .details-section { scroll-margin-top: 6rem; }
	.workflow-section, .details-section { margin-top: clamp(5rem, 10vw, 9rem); }
	.section-header { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); align-items: end; gap: clamp(2rem, 6vw, 7rem); margin-bottom: 1.5rem; padding: 0 .25rem; }
	.section-header h2 { margin: .5rem 0 0; color: var(--text-strong); font-size: clamp(2.4rem, 6vw, 5.5rem); font-weight: 730; line-height: .9; letter-spacing: -.065em; }
	.section-header > p { max-width: 34rem; margin: 0; color: var(--text-muted); font-size: .86rem; line-height: 1.7; }
	.section-header code { color: var(--text-strong); font-family: var(--font-mono); }
	.markdown-panel { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); }
	.catalog-markdown { padding: clamp(1.25rem, 3vw, 2.25rem); }
	.catalog-markdown :global(h2) { margin: 0 0 1rem; color: var(--text-strong); font-size: clamp(1.4rem, 3vw, 2.1rem); letter-spacing: -.04em; }
	.catalog-markdown :global(h2:not(:first-child)) { margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 2rem; }
	.catalog-markdown :global(ul) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; margin: 0; padding: 0; list-style: none; }
	.catalog-markdown :global(li) { position: relative; border: 1px solid var(--border); border-radius: var(--radius-medium); padding: .9rem 1rem .9rem 1.25rem; color: var(--text-muted); font-size: .78rem; line-height: 1.65; }
	.catalog-markdown :global(li::before) { content: ""; position: absolute; inset: .85rem auto .85rem 0; width: 3px; border-radius: 2px; background: var(--primary); }
	.catalog-markdown :global(a) { color: var(--text-strong); font-family: var(--font-mono); font-weight: 680; text-decoration: none; }
	.catalog-markdown :global(a:hover) { color: var(--primary); }
	.workflow-intro :global(p) { max-width: 34rem; margin: 0; color: var(--text-muted); font-size: .86rem; line-height: 1.7; }
	.workflow-list { display: grid; gap: 1rem; }
	.workflow-card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); overflow: hidden; }
	.workflow-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); align-items: end; padding: clamp(1.25rem, 3vw, 2rem); }
	.workflow-number { color: var(--primary); font: 760 clamp(2.8rem, 6vw, 5rem)/.8 var(--font-mono); letter-spacing: -.08em; }
	.workflow-heading h3 { margin: .35rem 0 0; color: var(--text-strong); font-size: clamp(1.7rem, 4vw, 3.3rem); line-height: 1; letter-spacing: -.055em; }
	.workflow-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--border); }
	.workflow-body :global(pre), .workflow-body :global(.mermaid-diagram) { grid-column: 1 / -1; margin: 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; padding: clamp(1rem, 3vw, 2.25rem); overflow-x: auto; background: var(--surface-deep); }
	.workflow-body :global(pre code) { padding: 0; background: transparent; font-family: var(--font-mono); white-space: pre; }
	.workflow-body :global(.mermaid-diagram) { display: grid; min-height: 19rem; place-items: center; }
	.workflow-body :global(.mermaid-diagram svg) { display: block; width: 100%; max-width: 72rem !important; height: auto; margin-inline: auto; }
	.workflow-body :global(.mermaid-diagram.has-error) { display: block; color: var(--red); font: 500 .78rem/1.6 var(--font-mono); white-space: pre; }
	.workflow-body :global(p), .workflow-body :global(ul), .workflow-body :global(ol), .workflow-body :global(blockquote) { min-width: 0; margin: 0; padding: clamp(1.15rem, 3vw, 1.75rem); color: var(--text-muted); font-size: .8rem; line-height: 1.75; }
	.workflow-body :global(p:nth-of-type(even)) { border-left: 1px solid var(--border); }
	.workflow-body :global(p:nth-of-type(n + 3)) { border-top: 1px solid var(--border); }
	.workflow-body :global(a) { color: var(--primary); font-family: var(--font-mono); font-weight: 650; text-decoration: none; }
	.workflow-body :global(strong) { color: var(--text-strong); font-weight: 700; }
	.workflow-body :global(code) { border-radius: .25rem; padding: .08rem .3rem; background: var(--surface-deep); color: var(--text-strong); font-family: var(--font-mono); }
	.workflow-body :global(h3), .workflow-body :global(h4) { grid-column: 1 / -1; margin: 0; border-top: 1px solid var(--border); padding: 1.25rem clamp(1.15rem, 3vw, 1.75rem) .25rem; color: var(--text-strong); }
	.skill-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
	.skill-card { min-width: 0; min-height: 20rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
	.skill-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--primary) 42%, var(--border)); background: var(--surface-hover); }
	.skill-card:target { border-color: var(--primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 24%, transparent), var(--card-shadow); }
	.skill-card header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--muted); }
	.skill-card header > span { color: var(--primary); }
	.skill-card code { min-width: 0; overflow: hidden; color: var(--muted); text-overflow: ellipsis; white-space: nowrap; }
	.skill-card h3 { margin: auto 0 1rem; color: var(--text-strong); font-size: clamp(1.7rem, 3vw, 2.7rem); font-weight: 720; line-height: 1; letter-spacing: -.05em; overflow-wrap: anywhere; }
	.skill-card > p { margin: 0; color: var(--text-muted); font-size: .82rem; line-height: 1.7; }
	.skill-card footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; color: var(--muted); }
	.skill-card footer a { margin-left: auto; color: var(--primary); text-decoration: none; }
	@media (max-width: 860px) {
		.hero-grid, .section-header { grid-template-columns: 1fr; }
		.catalog-markdown :global(ul) { grid-template-columns: 1fr; }
	}
	@media (max-width: 640px) {
		.skills-hero { padding-inline: .1rem; }
		.hero-meta { align-items: start; flex-direction: column; }
		.hero-grid { margin-top: 3.5rem; }
		.skills-hero h1 { font-size: clamp(3.5rem, 20vw, 6rem); }
		.skills-hero aside { grid-template-columns: 1fr; }
		.section-header { gap: 1rem; }
		.workflow-number { font-size: 2.6rem; }
		.workflow-heading { grid-template-columns: 1fr; align-items: start; }
		.workflow-body { grid-template-columns: 1fr; }
		.workflow-body :global(.mermaid-diagram) { min-height: 12rem; padding: .75rem; }
		.workflow-body :global(p:nth-of-type(even)) { border-left: 0; }
		.workflow-body :global(p:nth-of-type(n + 2)) { border-top: 1px solid var(--border); }
		.skill-list { grid-template-columns: 1fr; }
		.skill-card { min-height: 18rem; }
	}
</style>
