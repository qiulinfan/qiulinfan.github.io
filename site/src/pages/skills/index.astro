---
import LandingPageLayout from "@layouts/LandingPageLayout.astro";
import {
	loadPublishedSkills,
	loadPublishedRepositoryGroups,
	loadSkillDirectoryGroups,
	loadSkillWorkflowsMarkdown,
	orderSkillGroupsForDisplay,
} from "@utils/skill-sources";
import MarkdownIt from "markdown-it";

const markdown = new MarkdownIt({
	html: false,
	linkify: true,
	typographer: false,
});
const publishedSkills = loadPublishedSkills();
const skillGroups = orderSkillGroupsForDisplay([
	...loadSkillDirectoryGroups(),
	...loadPublishedRepositoryGroups(),
])
	.map((group) => ({
		...group,
		skills: group.skills.map((skill) => ({
			...skill,
			summaryHtml: markdown.renderInline(skill.summary),
		})),
	}));
const groupedSkills = skillGroups.flatMap((group) => group.skills);
const skillOrdinal = new Map(
	groupedSkills.map((skill, index) => [skill.name, index + 1]),
);
const skillAnchor = (name: string) => `skill-${name.replace(/[^a-z0-9]+/gi, "-")}`;
const groupAnchor = (group: (typeof skillGroups)[number]) =>
	`skill-group-${group.kind}-${group.directory || "root"}`;
const groupLabel = (group: (typeof skillGroups)[number]) =>
	group.kind === "repository"
		? `${group.directory} repository`
		: group.directory
			? `${group.directory}/`
			: "Other Skills";

const workflowSource = loadSkillWorkflowsMarkdown();
const workflowTokens = markdown.parse(workflowSource, {});
type MarkdownToken = (typeof workflowTokens)[number];
const workflowIntroTokens: MarkdownToken[] = [];
const workflows: Array<{
	title: string;
	tokens: MarkdownToken[];
}> = [];
let workflowTitle = "Skill Workflows";
let currentWorkflow: (typeof workflows)[number] | undefined;

for (let index = 0; index < workflowTokens.length; index += 1) {
	const token = workflowTokens[index];
	if (token.type === "heading_open" && token.tag === "h1") {
		workflowTitle = workflowTokens[index + 1]?.content || workflowTitle;
		index += 2;
		continue;
	}
	if (token.type === "heading_open" && token.tag === "h2") {
		currentWorkflow = {
			title:
				workflowTokens[index + 1]?.content ||
				`Workflow ${workflows.length + 1}`,
			tokens: [],
		};
		workflows.push(currentWorkflow);
		index += 2;
		continue;
	}
	(currentWorkflow?.tokens ?? workflowIntroTokens).push(token);
}

const renderTokens = (tokens: MarkdownToken[]) =>
	markdown.renderer.render(tokens, markdown.options, {});
const workflowIntroHtml = renderTokens(workflowIntroTokens);
const renderedWorkflows = workflows.map((workflow) => ({
	...workflow,
	html: renderTokens(workflow.tokens),
}));
---

<LandingPageLayout
	title="Skills & Workflows"
	description="Reusable Agent Skills and the Markdown-authored workflows they form together."
>
	<div class="skills-page">
		<header class="skills-hero">
			<div class="hero-meta">
				<span>CAPABILITIES × ORCHESTRATION</span>
				<span>{String(publishedSkills.length).padStart(2, "0")} SKILLS · {String(renderedWorkflows.length).padStart(2, "0")} FLOWS</span>
			</div>
			<div class="hero-grid">
				<h1>Skills<br /><em>&amp; Flows</em></h1>
				<div class="hero-copy">
					<nav aria-label="Page sections">
						<a href="#skill-index">Skill 导航 ↓</a>
						<a href="#workflows">工具流 ↓</a>
						<a href="#skill-details">自有 Skills ↓</a>
					</nav>
				</div>
			</div>
		</header>

		<section id="skill-index" class="index-section" data-pagefind-body>
			<header class="section-header">
				<div><span>01 / DIRECTORY</span><h2>Skill 导航</h2></div>
			</header>
			<div class="folder-tree" aria-label="Skills grouped by repository directory">
				{skillGroups.map((group, index) => (
					<details class="skill-folder" open={index === 0}>
						<summary>
							<span class="folder-icon" aria-hidden="true"></span>
							<span class="folder-heading">
								<strong>{groupLabel(group)}</strong>
								<code>{group.path}</code>
							</span>
							<span class="folder-count">{String(group.skills.length).padStart(2, "0")}</span>
						</summary>
						<ul class="folder-skills">
							{group.skills.map((skill) => (
								<li>
									<a href={`#${skillAnchor(skill.name)}`}>{skill.name}</a>
									<p set:html={skill.summaryHtml} />
								</li>
							))}
						</ul>
					</details>
				))}
			</div>
		</section>

		<section id="workflows" class="workflow-section" data-pagefind-body>
			<header class="section-header">
				<div><span>02 / WORKFLOWS.MD</span><h2>{workflowTitle}</h2></div>
				{workflowIntroHtml && <div class="workflow-intro" set:html={workflowIntroHtml} />}
			</header>
			<div class="workflow-list">
				{renderedWorkflows.map((workflow, index) => (
					<article class="workflow-card">
						<header class="workflow-heading">
							<div class="workflow-number">{String(index + 1).padStart(2, "0")}</div>
							<div>
								<span>WORKFLOW / MARKDOWN AUTHORED</span>
								<h3>{workflow.title}</h3>
							</div>
						</header>
						<div class="workflow-body" set:html={workflow.html} />
					</article>
				))}
			</div>
		</section>

		<section id="skill-details" class="details-section">
			<header class="section-header">
				<div><span>03 / OWNED PUBLIC SKILLS</span><h2>公开 Skill 详情</h2></div>
			</header>
			<div class="skill-detail-groups" data-pagefind-body aria-label="Personally maintained Agent Skills grouped by directory">
				{skillGroups.map((group) => (
					<section class="skill-detail-group" aria-labelledby={groupAnchor(group)}>
						<header class="detail-group-heading">
							<div>
								<span>{group.kind === "repository" ? "PUBLIC REPOSITORY" : group.directory ? "SUITE" : "ROOT"}</span>
								<h3 id={groupAnchor(group)}>{groupLabel(group)}</h3>
							</div>
							<code>{group.path} · {String(group.skills.length).padStart(2, "0")}</code>
						</header>
						<div class="skill-list">
							{group.skills.map((skill) => (
								<article class="skill-card" id={skillAnchor(skill.name)}>
									<header>
										<span>{String(skillOrdinal.get(skill.name)).padStart(2, "0")}</span>
										<code>{skill.id}</code>
									</header>
									<h3>{skill.name}</h3>
									<p>{skill.description}</p>
									<footer>
										{skill.license && <span>{skill.license}</span>}
										<a href={skill.sourceHref} target="_blank" rel="noreferrer">SKILL.md ↗</a>
									</footer>
								</article>
							))}
						</div>
					</section>
				))}
			</div>
		</section>
	</div>
</LandingPageLayout>

<style>
	.skills-page { padding: clamp(2rem, 6vw, 6rem) 0 3rem; }
	.skills-hero { margin-bottom: clamp(5rem, 10vw, 9rem); border-bottom: 1px solid var(--border); padding: 0 .25rem clamp(2rem, 5vw, 4rem); }
	.hero-meta, .section-header span, .workflow-heading span, .skill-card header, .skill-card footer { font: 650 .62rem/1.4 var(--font-sans); letter-spacing: .1em; }
	.hero-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); }
	.hero-meta span:first-child, .section-header span, .workflow-heading span { color: var(--primary); }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); align-items: end; gap: clamp(2rem, 6vw, 7rem); margin-top: clamp(3rem, 8vw, 7rem); }
	.skills-hero h1 { margin: 0; color: var(--text-strong); font-family: var(--font-sans); font-size: clamp(4rem, 11vw, 9.5rem); font-weight: 700; line-height: .82; letter-spacing: -.025em; font-feature-settings: "kern" 1; }
	.skills-hero h1 em { color: var(--primary); font-size: .66em; font-style: normal; letter-spacing: -.018em; }
	.hero-copy { align-self: end; }
	.hero-copy nav { display: flex; flex-wrap: wrap; gap: .65rem; }
	.hero-copy nav a { border: 1px solid var(--border); border-radius: var(--radius-small); padding: .75rem .9rem; background: var(--card-bg); color: var(--primary); font: 650 .68rem/1 var(--font-sans); text-decoration: none; }
	.index-section, .workflow-section, .details-section { scroll-margin-top: 6rem; }
	.workflow-section, .details-section { margin-top: clamp(5rem, 10vw, 9rem); }
	.section-header { margin-bottom: 1.5rem; padding: 0 .25rem; }
	.section-header h2 { margin: .5rem 0 0; color: var(--text-strong); font-size: clamp(2.4rem, 6vw, 5.5rem); font-weight: 730; line-height: .9; letter-spacing: -.065em; }
	.section-header > p { max-width: 34rem; margin: 0; color: var(--text-muted); font-size: .86rem; line-height: 1.7; }
	.section-header code { color: var(--text-strong); font-family: var(--font-sans); }
	.folder-tree { display: grid; gap: .8rem; }
	.skill-folder { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); overflow: hidden; }
	.skill-folder summary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 1rem; padding: clamp(1rem, 2.5vw, 1.5rem); cursor: pointer; list-style: none; }
	.skill-folder summary::-webkit-details-marker { display: none; }
	.skill-folder summary::after { content: "+"; width: 1.25rem; color: var(--primary); font: 700 1.1rem/1 var(--font-sans); text-align: center; }
	.skill-folder[open] summary::after { content: "−"; }
	.skill-folder[open] summary { border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--primary) 4%, var(--card-bg)); }
	.folder-icon { position: relative; width: 1.55rem; height: 1.05rem; border: 1px solid color-mix(in srgb, var(--primary) 55%, var(--border)); border-radius: .2rem; background: color-mix(in srgb, var(--primary) 13%, var(--surface-deep)); }
	.folder-icon::before { content: ""; position: absolute; left: .12rem; top: -.38rem; width: .7rem; height: .38rem; border: 1px solid color-mix(in srgb, var(--primary) 55%, var(--border)); border-bottom: 0; border-radius: .2rem .2rem 0 0; background: color-mix(in srgb, var(--primary) 13%, var(--surface-deep)); }
	.folder-heading { display: flex; min-width: 0; align-items: baseline; gap: .8rem; }
	.folder-heading strong { color: var(--text-strong); font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: -.025em; }
	.folder-heading code, .folder-count { color: var(--muted); font: 650 .64rem/1.4 var(--font-sans); letter-spacing: .08em; }
	.folder-heading code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.folder-count { border: 1px solid var(--border); border-radius: 999px; padding: .25rem .5rem; color: var(--primary); }
	.folder-skills { display: grid; margin: 0; padding: 0; list-style: none; }
	.folder-skills li { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: clamp(1rem, 3vw, 3rem); align-items: start; padding: 1rem clamp(1rem, 2.5vw, 1.5rem); }
	.folder-skills li + li { border-top: 1px solid var(--border); }
	.folder-skills li:hover { background: var(--surface-hover); }
	.folder-skills a { color: var(--text-strong); font: 680 .78rem/1.5 var(--font-sans); overflow-wrap: anywhere; text-decoration: none; }
	.folder-skills a:hover { color: var(--primary); }
	.folder-skills p { margin: 0; color: var(--text-muted); font-size: .78rem; line-height: 1.65; }
	.folder-skills p :global(a) { color: var(--primary); font: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--primary) 45%, transparent); text-underline-offset: .16em; }
	.workflow-intro :global(p) { max-width: 34rem; margin: 0; color: var(--text-muted); font-size: .86rem; line-height: 1.7; }
	.workflow-list { display: grid; gap: 1rem; }
	.workflow-card { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); overflow: hidden; }
	.workflow-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); align-items: end; padding: clamp(1.25rem, 3vw, 2rem); }
	.workflow-number { color: var(--primary); font: 760 clamp(2.8rem, 6vw, 5rem)/.8 var(--font-sans); letter-spacing: -.08em; }
	.workflow-heading h3 { margin: .35rem 0 0; color: var(--text-strong); font-size: clamp(1.7rem, 4vw, 3.3rem); line-height: 1; letter-spacing: -.055em; }
	.workflow-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--border); }
	.workflow-body :global(pre), .workflow-body :global(.mermaid-diagram) { grid-column: 1 / -1; margin: 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; padding: clamp(1rem, 3vw, 2.25rem); overflow-x: auto; background: var(--surface-deep); }
	.workflow-body :global(pre code) { padding: 0; background: transparent; font-family: var(--font-sans); white-space: pre; }
	.workflow-body :global(.mermaid-diagram) { display: grid; min-height: 19rem; place-items: center; }
	.workflow-body :global(.mermaid-diagram svg) { display: block; width: 100%; max-width: 72rem !important; height: auto; margin-inline: auto; }
	.workflow-body :global(.mermaid-diagram.has-error) { display: block; color: var(--red); font: 500 .78rem/1.6 var(--font-sans); white-space: pre; }
	.workflow-body :global(p), .workflow-body :global(ul), .workflow-body :global(ol), .workflow-body :global(blockquote) { min-width: 0; margin: 0; padding: clamp(1.15rem, 3vw, 1.75rem); color: var(--text-muted); font-size: .8rem; line-height: 1.75; }
	.workflow-body :global(p:nth-of-type(even)) { border-left: 1px solid var(--border); }
	.workflow-body :global(p:nth-of-type(n + 3)) { border-top: 1px solid var(--border); }
	.workflow-body :global(a) { color: var(--primary); font-family: var(--font-sans); font-weight: 650; text-decoration: none; }
	.workflow-body :global(strong) { color: var(--text-strong); font-weight: 700; }
	.workflow-body :global(code) { border-radius: .25rem; padding: .08rem .3rem; background: var(--surface-deep); color: var(--text-strong); font-family: var(--font-sans); }
	.workflow-body :global(h3), .workflow-body :global(h4) { grid-column: 1 / -1; margin: 0; border-top: 1px solid var(--border); padding: 1.25rem clamp(1.15rem, 3vw, 1.75rem) .25rem; color: var(--text-strong); }
	.skill-detail-groups { display: grid; gap: clamp(3rem, 7vw, 6rem); }
	.skill-detail-group { scroll-margin-top: 6rem; }
	.detail-group-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding: 0 .25rem 1rem; }
	.detail-group-heading span { color: var(--primary); font: 650 .62rem/1.4 var(--font-sans); letter-spacing: .1em; }
	.detail-group-heading h3 { margin: .3rem 0 0; color: var(--text-strong); font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1; letter-spacing: -.05em; }
	.detail-group-heading code { color: var(--muted); font: 650 .65rem/1.4 var(--font-sans); letter-spacing: .06em; }
	.skill-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
	.skill-card { min-width: 0; min-height: 20rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--card-bg); box-shadow: var(--card-shadow); padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
	.skill-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--primary) 42%, var(--border)); background: var(--surface-hover); }
	.skill-card:target { border-color: var(--primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 24%, transparent), var(--card-shadow); }
	.skill-card header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--muted); }
	.skill-card header > span { color: var(--primary); }
	.skill-card code { min-width: 0; overflow: hidden; color: var(--muted); text-overflow: ellipsis; white-space: nowrap; }
	.skill-card h3 { margin: auto 0 1rem; color: var(--text-strong); font-size: clamp(1.7rem, 3vw, 2.7rem); font-weight: 720; line-height: 1; letter-spacing: -.05em; overflow-wrap: anywhere; }
	.skill-card > p { margin: 0; color: var(--text-muted); font-size: .82rem; line-height: 1.7; }
	.skill-card footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; color: var(--muted); }
	.skill-card footer a { margin-left: auto; color: var(--primary); text-decoration: none; }
	@media (max-width: 860px) {
		.hero-grid, .section-header { grid-template-columns: 1fr; }
		.folder-skills li { grid-template-columns: 1fr; gap: .35rem; }
	}
	@media (max-width: 640px) {
		.skills-hero { padding-inline: .1rem; }
		.hero-meta { align-items: start; flex-direction: column; }
		.hero-grid { margin-top: 3.5rem; }
		.skills-hero h1 { font-size: clamp(3.5rem, 20vw, 6rem); }
		.section-header { gap: 1rem; }
		.workflow-number { font-size: 2.6rem; }
		.workflow-heading { grid-template-columns: 1fr; align-items: start; }
		.workflow-body { grid-template-columns: 1fr; }
		.workflow-body :global(.mermaid-diagram) { min-height: 12rem; padding: .75rem; }
		.workflow-body :global(p:nth-of-type(even)) { border-left: 0; }
		.workflow-body :global(p:nth-of-type(n + 2)) { border-top: 1px solid var(--border); }
		.folder-heading { display: grid; gap: .2rem; }
		.detail-group-heading { align-items: start; flex-direction: column; }
		.skill-list { grid-template-columns: 1fr; }
		.skill-card { min-height: 18rem; }
	}
</style>
