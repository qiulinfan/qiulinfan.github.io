---
import WidePageLayout from "@layouts/WidePageLayout.astro";
import { loadMarkdownNotes } from "@utils/note-sources";
import { url } from "@utils/url-utils";

const notes = loadMarkdownNotes();
const groups = Map.groupBy(notes, (note) => `${note.subject}/${note.course}`);
---

<WidePageLayout title="Notes" description="Source-backed Markdown notes">
	<section class="notes-index card-base">
		<header><span>KNOWLEDGE SOURCES</span><h1>Notes</h1><p>Markdown 权威源直接生成的网页；知识标记与全局图谱使用同一身份。</p></header>
		<div class="groups">
			{Array.from(groups.entries()).map(([name, entries]) => (
				<section>
					<h2>{name}</h2>
					<div class="note-list">
						{entries.map((note) => <a href={url(`/notes/${note.slug}/`)}><strong>{note.title}</strong><small>{note.authority}</small></a>)}
					</div>
				</section>
			))}
		</div>
	</section>
</WidePageLayout>

<style>
	.notes-index { padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius-large); }
	header span { font: 650 .68rem/1 "JetBrains Mono Variable", monospace; letter-spacing: .16em; }
	header h1 { margin: .55rem 0; font-size: clamp(2.2rem, 6vw, 4.5rem); }
	header p { margin: 0; color: color-mix(in oklch, currentColor 55%, transparent); }
	.groups { display: grid; gap: 2rem; margin-top: 2.5rem; }
	h2 { margin-bottom: .8rem; font-size: 1rem; font-family: "JetBrains Mono Variable", monospace; }
	.note-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: .7rem; }
	.note-list a { display: flex; min-height: 5rem; flex-direction: column; justify-content: space-between; gap: .7rem; padding: 1rem; border: 1px solid var(--line-divider); border-radius: .8rem; color: inherit; text-decoration: none; }
	.note-list a:hover { border-color: color-mix(in oklch, var(--primary) 55%, var(--line-divider)); transform: translateY(-1px); }
	.note-list small { overflow-wrap: anywhere; color: color-mix(in oklch, currentColor 44%, transparent); }
</style>
