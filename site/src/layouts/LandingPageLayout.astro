---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import { url } from "@utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang } = Astro.props;
const backdrop = `url("${url("/assets/backgrounds/one-dark-sakura-right-v3.webp")}")`;
const mascot = url("/assets/mascots/bluesamoyed-line-v3.png");
---

<Layout title={title} description={description} lang={lang}>
	<div class="site-backdrop" style={`--site-backdrop-image: ${backdrop}`}></div>
	<img
		class="site-mascot"
		src={mascot}
		alt=""
		aria-hidden="true"
		decoding="async"
	/>

	<div
		id="top-row"
		class="relative z-50 mx-auto max-w-[92rem] px-0 md:px-4"
	>
		<div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
			<Navbar />
		</div>
	</div>

	<main id="swup-container" class="transition-swup-fade mx-auto w-full max-w-[92rem] overflow-hidden px-2 md:px-4">
		<div id="content-wrapper" class="onload-animation">
			<slot />
			<Footer />
		</div>
	</main>

	<div class="relative mx-auto max-w-[92rem]">
		<BackToTop />
	</div>
	<div id="toc"></div>
</Layout>

<style>
	.site-mascot {
		position: fixed;
		left: clamp(1.5rem, 6vw, 7rem);
		bottom: clamp(.75rem, 4vh, 2.5rem);
		z-index: -1;
		width: clamp(11rem, 22vw, 22rem);
		height: auto;
		pointer-events: none;
		opacity: var(--site-backdrop-opacity);
		filter: var(--site-backdrop-filter);
	}

	@media (max-width: 40rem) {
		.site-mascot {
			left: -2rem;
			bottom: .5rem;
			width: 12rem;
		}
	}
</style>
