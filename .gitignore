# Obsidian community plugins are installed from the official marketplace on each
# machine. Keep reusable plugin data in Git without republishing bundled code.
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/plugins/*/main.js
/.obsidian/plugins/*/manifest.json
/.obsidian/plugins/*/styles.css

# Obsidian YOLO contains credentials, OAuth tokens and generated runtimes
/.obsidian/plugins/yolo/
/YOLO/

.obsidian/graph.json
.obsidian/plugins/obsidian-tinymist/data.json
